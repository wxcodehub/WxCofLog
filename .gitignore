yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & temp files
.cache/
.vite/
*.tmp
*.temp

# OS & Editor generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs (Exclude workspace personal data, keep team settings if needed)
.idea/
*.suo
*.ntvs*
