{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account info and their current shop association",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "currentShopId": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "manager", "staff"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Shop": {
      "title": "Shop",
      "description": "The coffee shop entity that groups users and inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "joinCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "joinCode"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "A single stock item in the inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "item": { "type": "string" },
        "stock": { "type": "number" },
        "unit": { "type": "string" },
        "exp_date": { "type": "string" },
        "category": { "type": "string", "enum": ["Beans", "Milk", "Sugar", "Others", "Packaging", "Syrup"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["item", "stock", "unit", "category"]
    },
    "SalesReport": {
      "title": "Sales Report",
      "description": "Daily or per-transaction sales data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "items": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": { "type": "string" },
              "qty": { "type": "number" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "totalAmount", "timestamp"]
    },
    "RestockReport": {
      "title": "Restock Report",
      "description": "Log of AI restocks that have been ordered",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "items": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": { "type": "string" },
              "item": { "type": "string" },
              "qty": { "type": "number" },
              "unit": { "type": "string" }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and shop pointers"
    },
    "/shops/{shopId}": {
      "schema": "Shop",
      "description": "Global shop document"
    },
    "/shops/{shopId}/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Inventory items belonging to a specific shop"
    },
    "/shops/{shopId}/sales/{salesId}": {
      "schema": "SalesReport",
      "description": "Sales history for prediction"
    },
    "/shops/{shopId}/restocks/{restockId}": {
      "schema": "RestockReport",
      "description": "Restock history for AI generated orders"
    }
  }
}
